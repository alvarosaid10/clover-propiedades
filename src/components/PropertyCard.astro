---
const { property } = Astro.props;
const details = [
  property.bedrooms ? `${property.bedrooms}D` : null,
  property.bathrooms ? `${property.bathrooms}B` : null,
  property.parking ? `${property.parking} est.` : null,
  property.total || null
].filter(Boolean);
---

<article class="group overflow-hidden rounded-2xl border border-black/10 bg-white shadow-[0_12px_40px_rgba(16,18,15,0.06)] transition duration-300 hover:-translate-y-1 hover:shadow-soft">
  <div class="relative aspect-[4/3] overflow-hidden bg-clover-50">
    <img
      src={property.image}
      alt={`${property.title} en ${property.location}`}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.035] group-hover:rotate-1"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/50 via-transparent to-transparent"></div>
    <div class="absolute left-4 top-4 flex gap-2">
      <span class="rounded-full bg-white/94 px-3 py-1 text-xs font-extrabold text-clover-700">{property.operation}</span>
      <span class="rounded-full bg-ink/88 px-3 py-1 text-xs font-extrabold text-white">Disponible</span>
    </div>
    <div class="absolute bottom-4 left-4 right-4 text-white">
      <p class="text-sm font-bold text-white/78">{property.location}</p>
      <h3 class="mt-1 text-2xl font-black leading-tight">{property.title}</h3>
    </div>
  </div>
  <div class="p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-bold text-clover-700">{property.operation}</p>
        <p class="mt-2 text-sm text-ink/58">{details.join(" · ")}</p>
      </div>
      <p class="shrink-0 text-right text-xl font-black text-ink">{property.price}</p>
    </div>
    <p class="mt-4 text-sm leading-6 text-ink/62">{property.summary}</p>
    <div class="mt-5 flex flex-wrap gap-2 text-sm">
      {details.map((detail) => (
        <span class="rounded-full bg-clover-50 px-3 py-2 font-extrabold text-clover-700">{detail}</span>
      ))}
    </div>
  </div>
</article>
