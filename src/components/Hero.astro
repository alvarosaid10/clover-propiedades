---
import site from "../data/site.json";

const whatsappUrl = `https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20comprar%2C%20vender%20o%20arrendar%20una%20propiedad.`;
const instagramUrl = `https://www.instagram.com/${site.instagram}/`;

const heroCards = [
  {
    title: "Asesoría humana",
    description: "Acompañamos cada paso con atención personalizada y soporte real.",
    icon: "human"
  },
  {
    title: "Análisis local",
    description: "Datos del mercado de Renca para decisiones más seguras.",
    icon: "chart"
  },
  {
    title: "Cierre confiable",
    description: "Negociaciones claras y acompañadas hasta la firma.",
    icon: "check"
  }
];
---

<section class="overflow-hidden pb-10 pt-6 md:pb-16 md:pt-10">
  <div class="container relative grid items-center gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="relative z-10">
      <p class="eyebrow">Bienvenido a Clover Propiedades</p>
      <h1 class="text-balance mt-5 max-w-3xl font-display text-[clamp(3.1rem,7vw,6.4rem)] font-semibold leading-[0.9] text-ink">
        Clover Propiedades
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-ink/68">
        Compra, vende y arrienda con una corredora enfocada en asesoría cercana, gestión clara y propiedades presentadas con criterio profesional.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a class="button button-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Escribir por WhatsApp
        </a>
        <a class="button button-instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer">
          Instagram @{site.instagram}
        </a>
        <a class="button button-secondary" href="#propiedades">
          Ver propiedades
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {heroCards.map((card) => (
          <div class="rounded-[1.75rem] border border-coffee-200/40 bg-white/80 p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-soft">
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-clover-100 text-clover-deep shadow-sm">
              {card.icon === "human" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="7" r="3" />
                  <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
                </svg>
              )}
              {card.icon === "chart" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 19h16" />
                  <path d="M7 15v-4" />
                  <path d="M12 15v-8" />
                  <path d="M17 15v-2" />
                </svg>
              )}
              {card.icon === "check" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" />
                </svg>
              )}
            </div>
            <p class="text-sm font-semibold text-ink">{card.title}</p>
            <p class="mt-2 text-sm leading-6 text-ink/70">{card.description}</p>
          </div>
        ))}
      </div>

    </div>

    <div class="relative">
      <div class="hero-panel card-frame rounded-[2rem] border border-coffee-100/60 bg-white/95 p-6 shadow-soft md:p-8">
        <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
          <div class="rounded-[1.75rem] border border-clover-100 bg-clover-50/40 p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-clover-700">Corredora local</p>
            <h2 class="mt-4 text-3xl font-black leading-tight text-clover-900 sm:text-4xl">Gestión inmobiliaria con transparencia, rapidez y cercanía.</h2>
            <p class="mt-5 text-sm leading-6 text-ink/70">
              En Clover Propiedades llevamos tus operaciones en Renca y alrededores con asesoría humana, visitas seguras y ofertas que se ajustan al mercado real.
            </p>

            <div class="mt-8 grid gap-4 sm:grid-cols-3">
              <div class="rounded-[1.5rem] bg-white p-4 shadow-sm">
                <p class="text-3xl font-black text-clover-900">70+</p>
                <p class="mt-2 text-xs uppercase tracking-[0.18em] text-coffee-700">Operaciones cerradas</p>
              </div>
              <div class="rounded-[1.5rem] bg-white p-4 shadow-sm">
                <p class="text-3xl font-black text-clover-900">100%</p>
                <p class="mt-2 text-xs uppercase tracking-[0.18em] text-coffee-700">Atención directa</p>
              </div>
              <div class="rounded-[1.5rem] bg-white p-4 shadow-sm">
                <p class="text-3xl font-black text-clover-900">5+</p>
                <p class="mt-2 text-xs uppercase tracking-[0.18em] text-coffee-700">Años de experiencia</p>
              </div>
            </div>
          </div>

          <div class="grid gap-4">
            <div class="rounded-[1.75rem] border border-black/10 bg-clover-900/95 p-6 text-white shadow-sm">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-clover-200">Una corredora con resultados</p>
              <p class="mt-3 text-xl font-black leading-snug">Aquí no hay promesas vacías: hay operaciones seguras y clientes bien acompañados.</p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              {heroCards.map((card) => (
                <div class="rounded-[1.5rem] border border-black/10 bg-white p-5 shadow-sm">
                  <p class="text-sm font-semibold text-clover-900">{card.title}</p>
                  <p class="mt-2 text-sm leading-6 text-ink/70">{card.description}</p>
                </div>
              ))}
            </div>

            <div class="rounded-[1.75rem] bg-white p-5 shadow-sm">
              <p class="text-xs font-extrabold uppercase tracking-[0.24em] text-coffee-700">Lo que nos hace distintos</p>
              <div class="mt-4 grid gap-3">
                <div class="rounded-2xl bg-clover-50/80 p-4">
                  <p class="text-sm font-black text-clover-900">Propiedades con presencia real</p>
                  <p class="mt-1 text-sm text-ink/70">Publicamos bien y mostramos lo mejor de cada espacio.</p>
                </div>
                <div class="rounded-2xl bg-clover-50/80 p-4">
                  <p class="text-sm font-black text-clover-900">Gestión transparente</p>
                  <p class="mt-1 text-sm text-ink/70">Aclara dudas, controla cada etapa y cierra con tranquilidad.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
