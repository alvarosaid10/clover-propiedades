---
import site from "../data/site.json";
---

<div class="brand-loader" aria-hidden="true">
  <div class="brand-loader-mark">
    <img src="/images/corporate/clover-logo-official-cropped.png" alt="" />
    <span></span>
  </div>
  <p>Clover Propiedades</p>
</div>

<section class="hero hero-estate" data-reveal>
  <div class="container hero-panel hero-estate-panel" data-parallax-scope>
    <div class="estate-ambient" aria-hidden="true">
      <span class="ambient-line line-a"></span>
      <span class="ambient-line line-b"></span>
      <span class="ambient-line line-c"></span>
    </div>

    <div class="hero-copy">
      <p class="eyebrow">Corretaje y gestión inmobiliaria</p>
      <h1 aria-label="Clover Propiedades Gestión Inmobiliaria">
        <span>Clover Propiedades</span>
        <span>Gestión Inmobiliaria</span>
      </h1>
      <p class="hero-lead">
        Propiedades en Chile. Compra, vende y arrienda con Clover Propiedades.
        Cumple tu sueño y obtén tu propiedad con asesoría cercana, ordenada y profesional.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20asesoria%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
          Hablar por WhatsApp
        </a>
        <a class="button button-soft" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
          Ver publicaciones
        </a>
      </div>
    </div>

    <div class="estate-stage" aria-label="Gestión inmobiliaria Clover Propiedades" data-parallax="0.08">
      <div class="estate-sun" aria-hidden="true"></div>
      <div class="estate-clover clover-a" aria-hidden="true"></div>
      <div class="estate-clover clover-b" aria-hidden="true"></div>

      <div class="estate-art">
        <img
          src="/images/hero/undraw-buy-house-clover.svg"
          alt="Ilustración de compra y gestión de propiedades"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="estate-service service-sale">Venta</div>
      <div class="estate-service service-rent">Arriendo</div>
      <div class="estate-service service-admin">Administración</div>
    </div>

    <div class="hero-metrics" aria-label="Enfoque de trabajo">
      <span><strong>01</strong> Evaluación</span>
      <span><strong>02</strong> Gestión comercial</span>
      <span><strong>03</strong> Cierre acompañado</span>
    </div>
  </div>
</section>
