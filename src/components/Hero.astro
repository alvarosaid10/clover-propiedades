---
import site from "../data/site.json";

const whatsappUrl = `https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20comprar%2C%20vender%20o%20arrendar%20una%20propiedad.`;
const instagramUrl = `https://www.instagram.com/${site.instagram}/`;

const heroCards = [
  {
    title: "Propiedad",
    description: "Venta y presentación con criterio profesional.",
    icon: "property"
  },
  {
    title: "Hogar",
    description: "Espacios pensados para vivir con calma.",
    icon: "home"
  },
  {
    title: "Seguridad",
    description: "Gestión clara y confianza en cada paso.",
    icon: "security"
  }
];
---

<section class="overflow-hidden pb-10 pt-6 md:pb-16 md:pt-10">
  <div class="container relative grid items-center gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="relative z-10">
      <p class="eyebrow">Bienvenido a Clover Propiedades</p>
      <h1 class="text-balance mt-5 max-w-3xl font-display text-[clamp(3.1rem,7vw,6.4rem)] font-semibold leading-[0.9] text-ink">
        Clover Propiedades
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-ink/68">
        Compra, vende y arrienda con una corredora enfocada en asesoría cercana, gestión clara y propiedades presentadas con criterio profesional.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a class="button button-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Escribir por WhatsApp
        </a>
        <a class="button button-instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer">
          Instagram @{site.instagram}
        </a>
        <a class="button button-secondary" href="#propiedades">
          Ver propiedades
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-[1.75rem] border border-coffee-200/50 bg-coffee-50/40 p-5 shadow-sm transition duration-300 hover:-translate-y-1">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-white text-coffee-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9.8 12 3l9 6.8v10.4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.8Z" />
              <path d="M9 22V12h6v10" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink">Propiedades</p>
          <p class="mt-2 text-sm text-ink/60">Diseño minimalista para compra y venta.</p>
        </div>
        <div class="rounded-[1.75rem] border border-coffee-200/50 bg-white/90 p-5 shadow-sm transition duration-300 hover:-translate-y-1">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-coffee-50 text-coffee-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 11 12 4l9 7v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9Z" />
              <path d="M7 20V12h10v8" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink">Hogar</p>
          <p class="mt-2 text-sm text-ink/60">Espacios pensados para vivir.</p>
        </div>
        <div class="rounded-[1.75rem] border border-coffee-200/50 bg-coffee-50/40 p-5 shadow-sm transition duration-300 hover:-translate-y-1">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-white text-coffee-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3 4 7v5c0 5 3.6 9.6 8 10 4.4-.4 8-5 8-10V7l-8-4Z" />
              <path d="M12 7v6" />
              <path d="M8 12h8" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink">Seguridad</p>
          <p class="mt-2 text-sm text-ink/60">Gestión clara para cada propiedad.</p>
        </div>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {heroCards.map((card) => (
          <div class="group hero-image-card transition duration-300 hover:-translate-y-1">
            <div class="relative overflow-hidden rounded-[1.5rem] bg-coffee-50/15 border border-coffee-100/60 p-6 shadow-[0_10px_30px_rgba(16,18,15,0.05)] flex items-center justify-center">
              {card.icon === "property" && (
                <svg viewBox="0 0 120 120" class="h-24 w-24 text-clover-900" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 90V45l40-27 40 27v45" />
                  <path d="M40 90v-24h40v24" />
                  <path d="M55 90v-18h10v18" />
                  <path d="M45 55h10M65 55h10" />
                </svg>
              )}
              {card.icon === "home" && (
                <svg viewBox="0 0 120 120" class="h-24 w-24 text-clover-900" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 70 60 30l40 40" />
                  <path d="M30 70v30h25V70" />
                  <path d="M65 70v30h25V70" />
                </svg>
              )}
              {card.icon === "security" && (
                <svg viewBox="0 0 120 120" class="h-24 w-24 text-clover-900" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M60 18 32 30v30c0 20 13 36 28 42 15-6 28-22 28-42V30L60 18z" />
                  <path d="M60 50v16" />
                  <circle cx="60" cy="80" r="5" />
                </svg>
              )}
            </div>
            <div class="p-4 pt-5">
              <p class="text-sm font-semibold text-ink">{card.title}</p>
              <p class="mt-2 text-sm text-ink/60">{card.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="relative">
      <div class="pointer-events-none absolute -left-12 top-8 hidden h-32 w-32 rounded-full bg-[radial-gradient(circle,rgba(215,183,125,0.16),transparent)] blur-2xl md:block"></div>
      <div class="pointer-events-none absolute right-0 top-24 hidden h-24 w-24 rounded-full bg-[radial-gradient(circle,rgba(184,217,154,0.12),transparent)] blur-2xl lg:block"></div>
      <div class="hero-panel card-frame corner-accent rounded-[1.75rem] p-6 md:p-9">
        <div class="relative overflow-hidden rounded-[1.75rem] border border-coffee-100/70 bg-coffee-50/10 p-4">
          <div class="absolute right-4 top-4 z-10 flex h-14 w-14 items-center justify-center rounded-3xl bg-white/96 border border-coffee-200 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-7 w-7 text-clover-900" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2c1.8 3.5 5.1 5 8 4 1.1-.4 2 0 2 1s-.9 1.4-2 1c-3.3 0-5 2.2-5 5s1.7 5 5 5c1.1 0 2 .5 2 1s-.9 1.4-2 1c-2.9-1-6.2.5-8 4-1.8-3.5-5.1-5-8-4-1.1.4-2 0-2-1s.9-1.4 2-1c3.3 0 5-2.2 5-5s-1.7-5-5-5c-1.1 0-2-.5-2-1s.9-1.4 2-1c2.9 1 6.2-.5 8-4Z" />
            </svg>
          </div>
          <svg viewBox="0 0 900 900" class="relative h-full w-full" aria-hidden="true">
            <defs>
              <linearGradient id="hero-bg" x1="0" x2="1" y1="0" y2="1">
                <stop offset="0%" stop-color="#f8faf4" />
                <stop offset="100%" stop-color="#dae4cd" />
              </linearGradient>
            </defs>
            <rect width="900" height="900" fill="url(#hero-bg)" rx="40" />
            <path d="M150 520h220v220H150z" fill="#fff" stroke="#31451f" stroke-width="20" rx="30" />
            <path d="M250 320h220v420H250z" fill="#dce8d3" stroke="#31451f" stroke-width="20" rx="30" />
            <path d="M470 400h220v340H470z" fill="#b8d99a" stroke="#31451f" stroke-width="20" rx="30" />
            <path d="M300 200 450 80 600 200" fill="none" stroke="#31451f" stroke-width="22" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="180" cy="160" r="24" fill="#31451f" />
            <circle cx="720" cy="180" r="18" fill="#31451f" />
            <path d="M560 180h120v90h-120z" fill="#31451f" opacity="0.18" />
          </svg>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="flex items-center justify-center rounded-full border border-coffee-200 bg-white/95 p-3 shadow-sm">
            <img src="/images/experiencia.png" alt="Felicidades" class="h-16 w-16 object-cover rounded-full" />
          </div>
          <div class="flex items-center justify-center rounded-full border border-coffee-200 bg-white/95 p-3 shadow-sm">
            <img src="/images/experiencia1.png" alt="Felicidades" class="h-16 w-16 object-cover rounded-full" />
          </div>
          <div class="flex items-center justify-center rounded-full border border-coffee-200 bg-white/95 p-3 shadow-sm">
            <img src="/images/experiencia2.png" alt="Felicidades" class="h-16 w-16 object-cover rounded-full" />
          </div>
        </div>

        <div class="border-t border-clover-900/12 pt-7">
          <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-clover-700">Clover Propiedades</p>
          <p class="mt-3 text-4xl font-black leading-[0.95] text-clover-900 md:text-6xl">Gestion inmobiliaria clara y cuidada.</p>
          <p class="mt-5 max-w-md text-sm font-semibold leading-6 text-ink/64">
            Venta, arriendo y asesoria con contacto directo, criterio profesional y presentacion pensada para generar confianza.
          </p>
        </div>
      </div>
      <div class="mt-4 grid gap-3 rounded-2xl border border-black/10 bg-white/60 p-4 backdrop-blur sm:grid-cols-3">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">Compra</p>
          <p class="mt-1 text-sm font-bold text-ink/70">Busqueda guiada</p>
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">Venta</p>
          <p class="mt-1 text-sm font-bold text-ink/70">Gestion y difusion</p>
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">Arriendo</p>
          <p class="mt-1 text-sm font-bold text-ink/70">Contacto directo</p>
        </div>
      </div>
    </div>
  </div>
</section>
