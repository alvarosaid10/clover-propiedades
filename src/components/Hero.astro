---
import site from "../data/site.json";
---

<div class="brand-loader" aria-hidden="true">
  <img src="/images/corporate/logo-clover-transparent-final.png" alt="" />
  <span></span>
  <p>Clover Propiedades</p>
</div>

<section class="hero hero-editorial" data-reveal>
  <div class="topography-texture" aria-hidden="true"></div>
  <svg class="hero-linework" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
    <g class="plan-lines">
      <path d="M-80 148 H360 M450 148 H1030 M1120 148 H1680" />
      <path d="M120 42 V820 M488 0 V740 M914 80 V900 M1324 18 V780" />
      <path d="M90 320 H550 V610 H220 V460 H90 Z" />
      <path d="M980 230 H1510 V602 H1210 V476 H980 Z" />
      <path d="M-60 770 C180 620 350 700 560 548 C790 382 970 450 1180 292 C1350 166 1490 190 1670 90" />
      <path d="M-120 840 C146 688 360 782 610 610 C850 444 1028 512 1260 366 C1420 264 1540 292 1680 228" />
    </g>
    <g class="survey-points">
      <circle cx="910" cy="148" r="4" />
      <circle cx="1210" cy="476" r="6" />
      <circle cx="488" cy="610" r="5" />
      <path d="M1300 252 h64 m-32 -32 v64" />
      <path d="M284 196 h48 m-24 -24 v48" />
    </g>
  </svg>

  <div class="container hero-editorial-grid" data-parallax-scope>
    <div class="hero-copy">
      <p class="eyebrow">Corretaje y gestión inmobiliaria</p>
      <h1 aria-label="Clover Propiedades Gestión Inmobiliaria">
        <span class="hero-title-main"><span>Clover</span> <span>Propiedades</span></span>
        <span class="hero-title-sub">Gestión Inmobiliaria</span>
      </h1>
      <p class="hero-lead">
        Compra, vende o arrienda con una gestión inmobiliaria ordenada.
        Te acompañamos con comunicación directa, publicación clara y seguimiento en cada etapa.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20asesoria%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
          Hablar por WhatsApp
        </a>
        <a class="button button-soft" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
          Ver publicaciones
        </a>
      </div>
    </div>

    <div class="clover-island-shell" data-clover-island data-parallax="0.018" aria-hidden="true">
      <div class="clover-island-canvas-host" data-island-canvas></div>
      <svg class="clover-island-fallback" data-island-fallback viewBox="0 0 720 520" role="img" aria-label="Maqueta de una propiedad sobre terreno con jardín">
        <defs>
          <linearGradient id="islandFallbackGround" x1="0%" x2="100%" y1="0%" y2="100%">
            <stop offset="0%" stop-color="#eff2f0" />
            <stop offset="100%" stop-color="#d3d9d5" />
          </linearGradient>
        </defs>
        <path d="M132 310c12-96 108-160 216-172 130-14 245 36 270 126 18 68-18 132-98 154-96 26-278 24-354-24-30-19-39-48-34-84Z" fill="url(#islandFallbackGround)" />
        <path d="M168 306c64-46 138-67 224-62 86 6 152 33 197 79" fill="none" stroke="#bfc8c2" stroke-width="3" />
        <path d="M210 346c56-35 116-50 183-45 66 5 118 24 158 59" fill="none" stroke="#bfc8c2" stroke-width="3" />
        <path d="M254 250h176v94H254z" fill="#eff2f0" stroke="#17201b" stroke-width="5" />
        <path d="M242 250l100-62 102 62" fill="none" stroke="#2f4d2c" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M448 272h72v72h-72z" fill="#d3d9d5" stroke="#17201b" stroke-width="4" />
        <path d="M286 286h48m32 0h48" stroke="#496a3b" stroke-width="5" stroke-linecap="round" />
        <path d="M132 386c54-30 102-39 154-31" fill="none" stroke="#2f4d2c" stroke-width="12" stroke-linecap="round" />
        <circle cx="552" cy="258" r="16" fill="none" stroke="#2f4d2c" stroke-width="5" />
        <path d="M552 275v38" stroke="#2f4d2c" stroke-width="5" stroke-linecap="round" />
        <path d="M176 268c20-28 45-28 66 0-27 16-45 16-66 0Z" fill="#7f9076" />
        <path d="M560 374c20-28 45-28 66 0-27 16-45 16-66 0Z" fill="#7f9076" />
      </svg>
    </div>

    <div class="hero-metrics" aria-label="Enfoque de trabajo">
      <span><strong>01</strong><i></i>Evaluación</span>
      <span><strong>02</strong><i></i>Gestión comercial</span>
      <span><strong>03</strong><i></i>Cierre acompañado</span>
    </div>
  </div>
</section>

<script>
  import { destroyCloverPropertyIslands, initCloverPropertyIsland } from "../scripts/clover-property-island.js";

  const bootCloverIsland = () => {
    document
      .querySelectorAll("[data-clover-island]:not([data-island-ready])")
      .forEach((root) => initCloverPropertyIsland(root));
  };

  bootCloverIsland();
  document.addEventListener("astro:page-load", bootCloverIsland);
  document.addEventListener("astro:before-swap", destroyCloverPropertyIslands);
</script>
