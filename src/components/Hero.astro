---
import site from "../data/site.json";
---

<section class="hero">
  <div class="container hero-panel">
    <div class="hero-copy">
      <p class="eyebrow">Corretaje y gestión inmobiliaria</p>
      <h1>
        <span>Clover Propiedades</span>
        <span>Gestión Inmobiliaria</span>
      </h1>
      <p class="hero-lead">
        Propiedades en Chile. Compra, vende y arrienda con nosotros.
        Cumple tu sueño y obtén tu propiedad con asesoría inmobiliaria profesional.
      </p>

      <div class="hero-proof">
        <span>Compra</span>
        <span>Vende</span>
        <span>Arrienda</span>
      </div>

      <div class="hero-actions">
        <a class="button button-primary" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20asesoria%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
          Hablar por WhatsApp
        </a>
        <a class="button button-soft" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
          Ver publicaciones
        </a>
      </div>
    </div>

    <div class="hero-media" aria-label="Material real de Clover Propiedades">
      <div class="hero-card hero-card-main">
        <div class="image-fade">
          <img class="fade-img fade-a" src="/images/corporate/asesora-clover.jpg" alt="Asesora de Clover Propiedades" loading="eager" />
          <img class="fade-img fade-b" src="/images/portfolio/propiedad-09.jpg" alt="Propiedad gestionada por Clover Propiedades" loading="eager" />
          <img class="fade-img fade-c" src="/images/hero/hero-propiedad-01.jpg" alt="Terraza de propiedad gestionada por Clover" loading="eager" />
          <img class="fade-img fade-d" src="/images/hero/hero-propiedad-02.jpg" alt="Interior de propiedad gestionada por Clover" loading="eager" />
          <img class="fade-img fade-e" src="/images/hero/hero-propiedad-03.jpg" alt="Acceso de condominio gestionado por Clover" loading="eager" />
          <img class="fade-img fade-f" src="/images/hero/hero-propiedad-04.jpg" alt="Walking closet de propiedad gestionada por Clover" loading="eager" />
          <img class="fade-img fade-g" src="/images/hero/hero-propiedad-05.jpg" alt="Patio de propiedad gestionada por Clover" loading="eager" />
          <img class="fade-img fade-h" src="/images/hero/hero-propiedad-06.jpg" alt="Cocina de propiedad gestionada por Clover" loading="eager" />
          <img class="fade-img fade-i" src="/images/hero/hero-propiedad-07.jpg" alt="Exterior de casa gestionada por Clover" loading="eager" />
          <img class="fade-img fade-j" src="/images/hero/hero-propiedad-08.jpg" alt="Comedor de propiedad gestionada por Clover" loading="eager" />
          <img class="fade-img fade-k" src="/images/hero/hero-propiedad-09.jpg" alt="Comedor interior de propiedad gestionada por Clover" loading="eager" />
          <img class="fade-img fade-l" src="/images/hero/hero-propiedad-10.jpg" alt="Hall de edificio gestionado por Clover" loading="eager" />
        </div>
      </div>

      <div class="hero-card hero-card-design" aria-hidden="true">
        <span class="design-clover"></span>
        <strong>Propiedades en Chile</strong>
        <p>Asesoría clara para avanzar con confianza.</p>
      </div>

      <div class="hero-card hero-card-note">
        <span class="mini-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20 7 9 18l-5-5"></path></svg>
        </span>
        <div>
          <strong>Gestión clara y segura</strong>
          <p>Evaluación, publicación, visitas, contratos y cierre acompañado.</p>
        </div>
      </div>
    </div>
  </div>
</section>
