---
import site from "../data/site.json";
---

<div class="brand-loader" aria-hidden="true">
  <img src="/images/corporate/logo-clover-transparent-final.png" alt="" />
  <span></span>
  <p>Clover Propiedades</p>
</div>

<section class="hero hero-editorial" data-reveal>
  <div class="topography-texture" aria-hidden="true"></div>
  <svg class="hero-linework" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
    <g class="plan-lines">
      <path d="M-80 148 H360 M450 148 H1030 M1120 148 H1680" />
      <path d="M120 42 V820 M488 0 V740 M914 80 V900 M1324 18 V780" />
      <path d="M90 320 H550 V610 H220 V460 H90 Z" />
      <path d="M980 230 H1510 V602 H1210 V476 H980 Z" />
      <path d="M-60 770 C180 620 350 700 560 548 C790 382 970 450 1180 292 C1350 166 1490 190 1670 90" />
      <path d="M-120 840 C146 688 360 782 610 610 C850 444 1028 512 1260 366 C1420 264 1540 292 1680 228" />
    </g>
    <g class="survey-points">
      <circle cx="910" cy="148" r="4" />
      <circle cx="1210" cy="476" r="6" />
      <circle cx="488" cy="610" r="5" />
      <path d="M1300 252 h64 m-32 -32 v64" />
      <path d="M284 196 h48 m-24 -24 v48" />
    </g>
  </svg>

  <div class="container hero-editorial-grid" data-parallax-scope>
    <div class="hero-copy">
      <p class="eyebrow">Corretaje y gestión inmobiliaria</p>
      <h1 aria-label="Clover Propiedades Gestión Inmobiliaria">
        <span>Clover Propiedades</span>
        <span>Gestión Inmobiliaria</span>
      </h1>
      <p class="hero-lead">
        Propiedades en Chile. Compra, vende y arrienda con Clover Propiedades.
        Cumple tu sueño y obtén tu propiedad con asesoría cercana, ordenada y profesional.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20asesoria%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
          Hablar por WhatsApp
        </a>
        <a class="button button-soft" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
          Ver publicaciones
        </a>
      </div>
    </div>

    <div class="hero-editorial-mark" aria-label="Logo editorial Clover Propiedades" data-parallax="0.035">
      <span class="editorial-number">01</span>
      <span class="editorial-axis" aria-hidden="true"></span>
      <div class="editorial-logo-lockup">
        <p>Gestión inmobiliaria</p>
        <img src="/images/corporate/logo-clover-transparent-final.png" alt="Clover Propiedades" />
      </div>
      <span class="editorial-coordinates">33.4569° S · 70.6827° W</span>
      <span class="editorial-route" aria-hidden="true"></span>
      <span class="editorial-point" aria-hidden="true"></span>
    </div>

    <div class="hero-metrics" aria-label="Enfoque de trabajo">
      <span><strong>01</strong><i></i>Evaluación</span>
      <span><strong>02</strong><i></i>Gestión comercial</span>
      <span><strong>03</strong><i></i>Cierre acompañado</span>
    </div>
  </div>
</section>
