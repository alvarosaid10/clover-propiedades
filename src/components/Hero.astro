---
import site from "../data/site.json";

const whatsappUrl = `https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20comprar%2C%20vender%20o%20arrendar%20una%20propiedad.`;
const instagramUrl = `https://www.instagram.com/${site.instagram}/`;
---

<section class="overflow-hidden pb-16 pt-8 md:pb-24 md:pt-14">
  <div class="container relative grid items-center gap-10 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="relative z-10">
      <p class="eyebrow">Bienvenido a Clover Propiedades</p>
      <h1 class="text-balance mt-5 max-w-3xl font-display text-[clamp(3.1rem,7vw,6.4rem)] font-semibold leading-[0.9] text-ink">
        Clover Propiedades
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-ink/68">
        Compra, vende y arrienda con una corredora enfocada en asesoria cercana, gestion clara y propiedades presentadas con criterio profesional.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a class="button button-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
        <a class="button button-instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
        <a class="button button-secondary" href="#propiedades">
          Ver propiedades
        </a>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <div class="rounded-[1.75rem] border border-coffee-200/50 bg-coffee-50/40 p-5 shadow-sm transition duration-300 hover:-translate-y-1">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-white text-coffee-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9.8 12 3l9 6.8v10.4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.8Z" />
              <path d="M9 22V12h6v10" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink">Propiedades</p>
          <p class="mt-2 text-sm text-ink/60">Diseño minimalista para compra y venta.</p>
        </div>
        <div class="rounded-[1.75rem] border border-coffee-200/50 bg-white/90 p-5 shadow-sm transition duration-300 hover:-translate-y-1">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-coffee-50 text-coffee-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 12c2.8 0 4-1.7 4-4s-1.2-4-4-4-4 1.7-4 4 1.2 4 4 4Z" />
              <path d="M3 21.5c0-3 2.3-5.5 5.2-5.5h7.6C18.7 16 21 18.5 21 21.5" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink">Familia</p>
          <p class="mt-2 text-sm text-ink/60">Cercanía y soporte en cada gestión.</p>
        </div>
        <div class="rounded-[1.75rem] border border-coffee-200/50 bg-coffee-50/40 p-5 shadow-sm transition duration-300 hover:-translate-y-1">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-3xl bg-white text-coffee-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3 4 7v5c0 5 3.6 9.6 8 10 4.4-.4 8-5 8-10V7l-8-4Z" />
              <path d="M12 7v6" />
              <path d="M8 12h8" />
            </svg>
          </div>
          <p class="text-sm font-semibold text-ink">Seguridad</p>
          <p class="mt-2 text-sm text-ink/60">Gestión clara para cada propiedad.</p>
        </div>
      </div>
    </div>

    <div class="relative">
      <div class="pointer-events-none absolute -left-12 top-8 hidden h-32 w-32 rounded-full bg-[radial-gradient(circle,rgba(215,183,125,0.16),transparent)] blur-2xl md:block"></div>
      <div class="pointer-events-none absolute right-0 top-24 hidden h-24 w-24 rounded-full bg-[radial-gradient(circle,rgba(184,217,154,0.12),transparent)] blur-2xl lg:block"></div>
      <div class="hero-panel corner-accent rounded-[1.75rem] p-6 md:p-9">          <span class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-3xl bg-white text-clover-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 20V9l8-5 8 5v11" />
              <path d="M9 20v-6h6v6" />
            </svg>
          </span>
          <strong class="block text-xl text-clover-700">Venta</strong>
          <span class="text-ink/60">Casas y deptos</span>
        </div>
        <div class="rounded-[1.55rem] border border-clover-900/10 bg-white/85 p-4 transition hover:-translate-y-0.5 hover:border-clover-700/25">
          <span class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-3xl bg-clover-50 text-clover-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8" cy="9" r="3" />
              <circle cx="16" cy="9" r="3" />
              <path d="M3 20a5 5 0 0 1 8-4" />
              <path d="M21 20a5 5 0 0 0-8-4" />
            </svg>
          </span>
          <strong class="block text-xl text-clover-700">Arriendo</strong>
          <span class="text-ink/60">Proceso claro</span>
        </div>
        <div class="rounded-[1.55rem] border border-clover-900/10 bg-clover-50/70 p-4 backdrop-blur transition hover:-translate-y-0.5 hover:border-clover-700/25">
          <span class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-3xl bg-white text-clover-700 shadow-sm">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8" cy="8" r="4" />
              <path d="m11 11 9 9" />
              <path d="m16 16 2-2" />
              <path d="m19 19 2-2" />
            </svg>
          </span>
          <strong class="block text-xl text-clover-700">Asesoria</strong>
          <span class="text-ink/60">Acompanamiento</span>
        </div>
      </div>
    </div>

    <div class="relative">
      <div class="hero-panel corner-accent rounded-[1.75rem] p-6 md:p-9">
        <div class="absolute right-5 top-5 z-10 md:right-7 md:top-7">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/88 shadow-[0_14px_34px_rgba(16,18,15,0.08)] animate-bounce-in">
            <svg viewBox="0 0 64 64" class="h-10 w-10 text-[#b8d99a] md:h-12 md:w-12" aria-hidden="true">
              <path fill="currentColor" d="M31.9 20.8c-2.4-9.4-16.1-9.6-16.1 1.5 0 8.3 10.7 13.8 16.1 19.7 5.4-5.9 16.2-11.4 16.2-19.7 0-11.1-13.8-10.9-16.2-1.5Z"/>
              <path fill="currentColor" d="M15.8 42.4c-9.4 2.4-9.6 16.1 1.5 16.1 8.3 0 13.8-10.7 19.7-16.1-5.9-5.4-11.4-16.2-19.7-16.2-11.1 0-10.9 13.8-1.5 16.2Z"/>
              <path fill="currentColor" d="M48.2 42.4c9.4 2.4 9.6 16.1-1.5 16.1-8.3 0-13.8-10.7-19.7-16.1 5.9-5.4 11.4-16.2 19.7-16.2 11.1 0 10.9 13.8 1.5 16.2Z"/>
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="5" d="M32 39c4.4 8.7 4.6 17.2 0 25"/>
            </svg>
          </div>
        </div>
        <img
          src="/images/hero/clover-hero.svg"
          alt="Ilustracion arquitectonica Clover Propiedades"
          class="relative h-auto w-full pt-8"
          loading="eager"
        />
        <div class="border-t border-clover-900/12 pt-7">
          <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-clover-700">Clover Propiedades</p>
          <p class="mt-3 text-4xl font-black leading-[0.95] text-clover-900 md:text-6xl">Gestion inmobiliaria clara y cuidada.</p>
          <p class="mt-5 max-w-md text-sm font-semibold leading-6 text-ink/64">
            Venta, arriendo y asesoria con contacto directo, criterio profesional y presentacion pensada para generar confianza.
          </p>
        </div>
      </div>
      <div class="mt-4 grid gap-3 rounded-2xl border border-black/10 bg-white/60 p-4 backdrop-blur sm:grid-cols-3">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">Compra</p>
          <p class="mt-1 text-sm font-bold text-ink/70">Busqueda guiada</p>
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">Venta</p>
          <p class="mt-1 text-sm font-bold text-ink/70">Gestion y difusion</p>
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">Arriendo</p>
          <p class="mt-1 text-sm font-bold text-ink/70">Contacto directo</p>
        </div>
      </div>
    </div>
  </div>
</section>
