---
import site from "../data/site.json";
---

<div class="brand-loader" aria-hidden="true">
  <div class="brand-loader-mark">
    <img src="/images/corporate/clover-logo-official-cropped.png" alt="" />
    <span></span>
  </div>
  <p>Clover Propiedades</p>
</div>

<section class="hero hero-estate hero-architectural" data-reveal>
  <div class="architectural-field" aria-hidden="true">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
      <g class="field-grid">
        <path d="M80 110 H1480 M120 230 H1540 M40 390 H1500 M160 560 H1580 M0 730 H1510" />
        <path d="M170 0 V820 M360 40 V900 M548 0 V860 M760 80 V900 M1030 0 V840 M1280 60 V900 M1450 0 V760" />
      </g>
      <g class="field-topography layer-slow">
        <path d="M-80 680 C120 560 240 650 410 520 C610 368 790 472 960 318 C1120 174 1320 212 1700 38" />
        <path d="M-120 760 C120 640 290 728 470 590 C650 452 820 522 1010 382 C1210 236 1370 302 1700 128" />
        <path d="M-100 830 C160 710 330 792 528 656 C720 524 900 592 1114 458 C1320 330 1480 392 1710 260" />
      </g>
      <g class="field-cadastre layer-mid">
        <path d="M1010 170 H1320 V360 H1130 V292 H1010 Z" />
        <path d="M1160 404 H1480 V640 H1268 V574 H1160 Z" />
        <path d="M220 228 H520 V392 H384 V522 H220 Z" />
        <path d="M610 116 H780 V286 H610 Z" />
      </g>
      <g class="field-geometry layer-fast">
        <circle cx="1210" cy="270" r="132" />
        <circle cx="1240" cy="510" r="214" />
        <path d="M1032 270 H1388 M1210 92 V448" />
        <path d="M312 610 a190 190 0 1 0 380 0 a190 190 0 1 0 -380 0" />
        <path d="M312 610 H692 M502 420 V800" />
      </g>
      <g class="field-marks">
        <path d="M136 146 h38 m-19 -19 v38" />
        <path d="M1412 154 h38 m-19 -19 v38" />
        <path d="M892 722 h38 m-19 -19 v38" />
        <circle cx="984" cy="194" r="4" />
        <circle cx="1410" cy="626" r="5" />
        <circle cx="276" cy="512" r="4" />
      </g>
    </svg>
  </div>

  <div class="container hero-panel hero-estate-panel" data-parallax-scope>
    <div class="hero-copy">
      <p class="eyebrow">Corretaje y gestión inmobiliaria</p>
      <h1 aria-label="Clover Propiedades Gestión Inmobiliaria">
        <span>Clover Propiedades</span>
        <span>Gestión Inmobiliaria</span>
      </h1>
      <p class="hero-lead">
        Propiedades en Chile. Compra, vende y arrienda con Clover Propiedades.
        Cumple tu sueño y obtén tu propiedad con asesoría cercana, ordenada y profesional.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20asesoria%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
          Hablar por WhatsApp
        </a>
        <a class="button button-soft" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
          Ver publicaciones
        </a>
      </div>
    </div>

    <div class="hero-visual" aria-label="Emblema arquitectónico Clover Propiedades" data-parallax="0.06">
      <svg class="lucide-emblem" viewBox="0 0 560 560" role="img" aria-label="Edificio, casa, escudo, hoja y ubicación">
        <g class="emblem-construct">
          <path d="M104 442 H456" />
          <path d="M148 442 V186 a24 24 0 0 1 24 -24 h144 a24 24 0 0 1 24 24 v256" />
          <path d="M340 278 h56 a24 24 0 0 1 24 24 v140" />
          <path d="M196 218 h44 M196 270 h44 M196 322 h44 M196 374 h44" />
          <path d="M286 218 h32 M286 270 h32 M286 322 h32 M286 374 h32" />
          <path d="M184 162 L280 94 L376 162" />
          <path d="M226 442 v-74 a18 18 0 0 1 18 -18 h72 a18 18 0 0 1 18 18 v74" />
        </g>

        <g class="emblem-shield">
          <path d="M280 464 s112 -56 112 -146 V194 l-112 -42 l-112 42 v124 c0 90 112 146 112 146 Z" />
          <path d="m238 312 30 30 58 -70" />
        </g>

        <g class="emblem-leaf">
          <path d="M410 150 C468 126 500 152 502 196 C462 200 426 194 410 150 Z" />
          <path d="M410 150 C426 170 442 184 470 194" />
        </g>

        <g class="emblem-pin">
          <path d="M430 292 c0 48 -52 94 -70 108 c-18 -14 -70 -60 -70 -108 a70 70 0 0 1 140 0 Z" />
          <circle cx="360" cy="292" r="18" />
        </g>

        <g class="emblem-logo">
          <foreignObject x="204" y="246" width="152" height="76">
            <img src="/images/corporate/clover-logo-official-cropped.png" alt="" />
          </foreignObject>
        </g>
      </svg>
    </div>

    <div class="hero-metrics" aria-label="Enfoque de trabajo">
      <span><strong>01</strong> Evaluación</span>
      <span><strong>02</strong> Gestión comercial</span>
      <span><strong>03</strong> Cierre acompañado</span>
    </div>
  </div>
</section>
