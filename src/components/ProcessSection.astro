---
const steps = [
  { title: "Diagnostico", text: "Revisamos la propiedad, su contexto y la mejor estrategia comercial." },
  { title: "Preparacion", text: "Ordenamos fotos, publicacion, documentacion y criterios de visita." },
  { title: "Gestion", text: "Filtramos interesados, coordinamos visitas y negociamos con claridad." },
  { title: "Cierre", text: "Acompanamos firma, entrega y seguimiento final." }
];
---

<section id="proceso" class="section-shell py-14 md:py-20">
  <div class="container">
    <div class="process-panel">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Metodo Clover</p>
          <h2 class="section-title mt-4">Un proceso ordenado genera mejores decisiones.</h2>
        </div>
        <p>
          La diferencia esta en acompanar con informacion clara, tiempos reales y supervision constante del inmueble.
        </p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-4">
        {steps.map((step, index) => (
          <article class="process-step">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
