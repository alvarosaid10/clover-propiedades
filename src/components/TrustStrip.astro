---
const items = [
  {
    title: "Propiedades",
    text: "Casas, departamentos y oportunidades",
    icon: "home"
  },
  {
    title: "Familias",
    text: "Acompanamiento cercano",
    icon: "family"
  },
  {
    title: "Llaves",
    text: "Cierres claros y ordenados",
    icon: "key"
  },
  {
    title: "Seguridad",
    text: "Contacto directo y gestion clara",
    icon: "shield"
  }
];
---

<section class="pb-8">
  <div class="container">
    <div class="grid gap-3 rounded-[1.75rem] border border-black/10 bg-white/74 p-3 shadow-[0_12px_40px_rgba(16,18,15,0.05)] backdrop-blur md:grid-cols-4 section-accent">
      {items.map((item) => (
        <div class="group flex items-center gap-3 rounded-2xl border border-transparent bg-white/80 px-3 py-4 transition duration-300 hover:border-clover-200 hover:bg-clover-50/90 pattern-bg">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-clover-50 text-clover-700 transition duration-300 group-hover:bg-clover-100">
            {item.icon === "home" && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 20V9l8-5 8 5v11" />
                <path d="M9 20v-6h6v6" />
              </svg>
            )}
            {item.icon === "family" && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="9" r="3" />
                <circle cx="16" cy="9" r="3" />
                <path d="M3 20a5 5 0 0 1 8-4" />
                <path d="M21 20a5 5 0 0 0-8-4" />
              </svg>
            )}
            {item.icon === "key" && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="8" r="4" />
                <path d="m11 11 9 9" />
                <path d="m16 16 2-2" />
                <path d="m19 19 2-2" />
              </svg>
            )}
            {item.icon === "shield" && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                <path d="m9 12 2 2 4-5" />
              </svg>
            )}
          </span>
          <div>
            <p class="text-sm font-black text-clover-900">{item.title}</p>
            <p class="mt-1 text-xs font-semibold leading-5 text-ink/55">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
