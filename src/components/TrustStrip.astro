---
const items = [
  { title: "Venta", text: "Evaluacion, publicacion, visitas, negociacion y apoyo hasta la firma.", icon: "home" },
  { title: "Arriendo", text: "Fijacion de precio, seleccion de arrendatarios, contrato y entrega.", icon: "key" },
  { title: "Administracion", text: "Cobros, pagos, supervision del inmueble e informes periodicos.", icon: "people" },
  { title: "Acompanamiento", text: "Orden documental, gestion completa y asesoria en cada etapa.", icon: "shield" }
];
---

<section class="pb-10">
  <div class="container">
    <div class="trust-panel grid gap-3 rounded-[1.75rem] border border-black/10 bg-white/82 p-3 shadow-[0_12px_40px_rgba(16,18,15,0.05)] backdrop-blur md:grid-cols-4">
      {items.map((item) => (
        <div class="trust-item">
          <span class="trust-icon">
            {item.icon === "home" && <svg viewBox="0 0 24 24"><path d="M4 20V9l8-5 8 5v11"/><path d="M9 20v-6h6v6"/></svg>}
            {item.icon === "key" && <svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="4"/><path d="m11 11 9 9"/><path d="m16 16 2-2"/><path d="m19 19 2-2"/></svg>}
            {item.icon === "people" && <svg viewBox="0 0 24 24"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><path d="M3 20a5 5 0 0 1 8-4"/><path d="M21 20a5 5 0 0 0-8-4"/></svg>}
            {item.icon === "shield" && <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-5"/></svg>}
          </span>
          <div>
            <p class="text-sm font-black text-clover-900">{item.title}</p>
            <p class="mt-1 text-xs font-semibold leading-5 text-ink/58">{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
