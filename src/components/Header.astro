---
import site from "../data/site.json";
---

<header class="sticky top-0 z-50 border-b border-coffee-200/50 bg-gradient-to-r from-white to-coffee-50/30 backdrop-blur-xl">
  <div class="container flex min-h-[76px] items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label="Ir al inicio">
      <img src="/images/brand/clover-logo.svg" alt="Clover Propiedades" class="h-11 w-auto wiggle-on-hover" />
    </a>
    <nav class="hidden items-center gap-7 text-sm font-bold text-ink/68 md:flex">
      <a class="hover:text-clover-700 transition-transform hover:scale-105" href="#servicios">Servicios</a>
      <a class="hover:text-clover-700 transition-transform hover:scale-105" href="#propiedades">Propiedades</a>
      <a class="hover:text-clover-700 transition-transform hover:scale-105" href="#experiencia">Experiencia</a>
      <a class="hover:text-clover-700 transition-transform hover:scale-105" href="#contacto">Contacto</a>
    </nav>
    <div class="hidden h-11 w-[92px] md:block" aria-hidden="true"></div>
  </div>
</header>
