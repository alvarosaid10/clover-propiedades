---
import site from "../data/site.json";
---

<header class="relative sticky top-0 z-50 border-b border-coffee-200/50 bg-white/90 backdrop-blur-xl shadow-sm">
  <div class="absolute inset-x-0 inset-y-0 pointer-events-none bg-[radial-gradient(circle_at_top_left,rgba(184,217,154,0.14),transparent_24%),radial-gradient(circle_at_top_right,rgba(215,183,125,0.12),transparent_22%)]"></div>
  <div class="container relative flex min-h-[76px] items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label="Ir al inicio">
      <img src="/images/brand/clover-logo.svg" alt="Clover Propiedades" class="h-11 w-auto logo-swing" />
    </a>
    <nav class="hidden items-center gap-7 text-sm font-bold text-ink/68 md:flex">
      <a class="nav-link" href="#servicios">Servicios</a>
      <a class="nav-link" href="#propiedades">Propiedades</a>
      <a class="nav-link" href="#experiencia">Experiencia</a>
      <a class="nav-link" href="#contacto">Contacto</a>
    </nav>
    <div class="hidden items-center gap-2 rounded-full border border-coffee-200/80 bg-white/80 px-3 py-2 text-[0.72rem] font-semibold text-coffee-800 md:flex">
      <span class="h-2.5 w-2.5 rounded-full bg-clover"></span>
      Compra | Vende | Arrienda
    </div>
  </div>
</header>
