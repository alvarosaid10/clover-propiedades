---
const images = [
  { src: "/images/portfolio/propiedad-01.jpg", label: "Casa familiar" },
  { src: "/images/portfolio/propiedad-03.jpg", label: "Terraza y exterior" },
  { src: "/images/portfolio/propiedad-05.jpg", label: "Departamento" },
  { src: "/images/portfolio/propiedad-06.jpg", label: "Interior equipado" },
  { src: "/images/portfolio/propiedad-08.jpg", label: "Vista y entorno" },
  { src: "/images/portfolio/propiedad-09.jpg", label: "Cocina y comedor" }
];
---

<section id="experiencia" class="section-shell bg-white py-14 md:py-20">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Experiencia real</p>
        <h2 class="section-title mt-4">Propiedades gestionadas con imagen cuidada.</h2>
      </div>
      <p>
        Presentamos evidencia real de gestion, tipos de inmuebles y material comercial usado por Clover para mostrar experiencia sin crear falsas expectativas de disponibilidad.
      </p>
    </div>

    <div class="portfolio-grid mt-10">
      {images.map((image, index) => (
        <figure class={index === 0 || index === 4 ? "portfolio-card portfolio-card-large" : "portfolio-card"}>
          <img src={image.src} alt={image.label} loading="lazy" />
          <figcaption>{image.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
