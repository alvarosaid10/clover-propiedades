---
const photos = [
  ["/images/portfolio/propiedad-01.jpg", "Casa familiar"],
  ["/images/portfolio/propiedad-03.jpg", "Terraza preparada"],
  ["/images/portfolio/propiedad-06.jpg", "Departamento"],
  ["/images/portfolio/propiedad-09.jpg", "Cocina y comedor"],
  ["/images/portfolio/propiedad-08.jpg", "Entorno y vista"]
];
---

<section id="experiencia" class="experience-card">
  <div class="experience-copy">
    <p class="eyebrow">Experiencia</p>
    <h2>Imagen cuidada para propiedades reales.</h2>
    <p>
      Clover trabaja con material visual claro para mostrar cada propiedad de forma
      seria: interiores, exteriores, entorno, atributos principales y mensajes
      comerciales faciles de entender.
    </p>
    <div class="experience-points">
      <span>Publicacion preparada</span>
      <span>Filtro comercial</span>
      <span>Seguimiento cercano</span>
    </div>
  </div>

  <div class="photo-mosaic" aria-label="Muestra de propiedades gestionadas">
    {photos.map(([src, alt]) => (
      <figure>
        <img src={src} alt={alt} loading="lazy" />
      </figure>
    ))}
  </div>
</section>
