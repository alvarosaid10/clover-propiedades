---
import successes from "../data/successes.json";

const featured = successes;
---

<section id="experiencia" class="proof-section" data-reveal>
  <div class="container proof-panel premium-surface">
    <div class="proof-copy">
      <p class="eyebrow">Experiencia real</p>
      <h2>Casos gestionados con respaldo visual</h2>
      <p>
        Una muestra acotada de propiedades y publicaciones reales trabajadas por
        Clover Propiedades. Esta sección comunica experiencia, no disponibilidad actual.
      </p>
      <div class="proof-badges" aria-label="Señales de confianza">
        <span>Transparencia</span>
        <span>Material real</span>
        <span>Contacto directo</span>
      </div>
    </div>

    <div class="proof-grid">
      {featured.map((item, index) => (
        <article class="proof-card" style={`--proof:${index}`} data-tilt-card>
          <div class="proof-image">
            <img src={item.secondaryImage} alt={`Publicación real de Clover Propiedades asociada a ${item.location}`} loading="lazy" decoding="async" />
            <img class="proof-image-alt" src={item.image} alt={`Registro fotográfico de experiencia inmobiliaria de Clover Propiedades en ${item.location}`} loading="lazy" decoding="async" />
          </div>
          <div class="proof-body">
            <span>{item.kind}</span>
            <h3>{item.title}</h3>
            <p>{item.location}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
