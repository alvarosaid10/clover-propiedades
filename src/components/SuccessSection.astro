---
import successes from "../data/successes.json";

const featured = successes;
---

<section id="experiencia" class="proof-section" data-reveal>
  <div class="container proof-panel premium-surface">
    <div class="proof-copy">
      <p class="eyebrow">Experiencia real</p>
      <h2>Gestiones que se pueden ver</h2>
      <p>
        Casos reales en distintas zonas de Chile. Cada pieza combina fotografía
        de propiedad y publicación de Clover Propiedades para mostrar contexto,
        trazabilidad y respaldo comercial.
      </p>
      <div class="proof-badges" aria-label="Señales de confianza">
        <span>Transparencia</span>
        <span>Publicación real</span>
        <span>Contacto directo</span>
      </div>
    </div>

    <div class="proof-grid">
      {featured.map((item, index) => (
        <article class="proof-card" style={`--proof:${index}`} data-tilt-card>
          <div class="proof-image">
            <img src={item.image} alt={`${item.title} - ${item.location}`} loading="lazy" decoding="async" />
            <img class="proof-image-alt" src={item.secondaryImage} alt={`Publicación Clover - ${item.location}`} loading="lazy" decoding="async" />
          </div>
          <div class="proof-body">
            <span>{item.kind}</span>
            <h3>{item.title}</h3>
            <p>{item.location}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
