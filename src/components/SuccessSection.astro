---
import successes from "../data/successes.json";

const featured = successes;
---

<section id="experiencia" class="proof-section" data-reveal>
  <div class="container proof-panel">
    <div class="proof-copy">
      <p class="eyebrow">Experiencia real</p>
      <h2>Propiedades gestionadas con confianza</h2>
      <p>
        Tres ejemplos reales de gestión en distintas zonas. La imagen cambia suavemente
        entre foto de propiedad y publicación de Clover Propiedades para mostrar contexto y respaldo.
      </p>
    </div>

    <div class="proof-grid">
      {featured.map((item) => (
        <article class="proof-card">
          <div class="proof-image">
            <img src={item.image} alt={`${item.title} - ${item.location}`} loading="lazy" decoding="async" />
            <img class="proof-image-alt" src={item.secondaryImage} alt={`Publicación Clover - ${item.location}`} loading="lazy" decoding="async" />
          </div>
          <div class="proof-body">
            <span>{item.kind}</span>
            <h3>{item.title}</h3>
            <p>{item.location}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
