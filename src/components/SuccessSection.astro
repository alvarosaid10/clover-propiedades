---
import successes from "../data/successes.json";

const visibleSuccesses = successes.filter((item) => item.visible !== false);
---

<section id="experiencia" class="bg-clover-50 section-accent py-16 md:py-24">
  <div class="container">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="section-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </span>
          <p class="eyebrow">Confianza</p>
        </div>
        <h2 class="section-title mt-4">Experiencia en ventas y asesorias.</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-ink/62">
        Una muestra de gestiones ya cerradas por Clover Propiedades. Sirve para mostrar experiencia sin guardar datos privados.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {visibleSuccesses.map((item) => (
        <article class="group overflow-hidden rounded-[2rem] border border-black/10 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1">
          <div class="relative overflow-hidden rounded-[1.5rem] bg-clover-50">
            <img src={item.image} alt={`${item.title} en ${item.location}`} class="h-64 w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink/30 via-transparent to-transparent"></div>
          </div>
          <div class="mt-6 flex items-center gap-3">
            <span class="grid h-12 w-12 place-items-center rounded-3xl bg-clover-50 text-clover-700 shadow-sm">
              {item.kind === "Venta" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 20V9l8-5 8 5v11" />
                  <path d="M9 20v-6h6v6" />
                </svg>
              )}
              {item.kind === "Arriendo" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="8" cy="8" r="3" />
                  <path d="m11 11 9 9" />
                  <path d="m16 16 2-2" />
                  <path d="m19 19 2-2" />
                </svg>
              )}
              {item.kind === "Asesoria" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z" />
                  <path d="M21 12a3 3 0 1 0-6 0 3 3 0 0 0 6 0Z" />
                  <path d="M3 21v-2a6 6 0 0 1 10-4.4" />
                  <path d="M23 21v-2a6 6 0 0 0-10-4.4" />
                </svg>
              )}
              {item.kind !== "Venta" && item.kind !== "Arriendo" && item.kind !== "Asesoria" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2l7 7-7 13-7-13 7-7Z" />
                </svg>
              )}
            </span>
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">{item.kind}</p>
              <p class="text-sm text-ink/65">{item.client}</p>
            </div>
          </div>
          <h3 class="mt-4 text-2xl font-black text-ink">{item.title}</h3>
          <p class="mt-3 text-sm leading-6 text-ink/65">{item.location}</p>
        </article>
      ))}
    </div>
  </div>
</section>
