---
import successes from "../data/successes.json";

const featured = successes.slice(0, 3);
---

<section id="resultados" class="proof-section">
  <div class="container proof-panel">
    <div class="proof-copy">
      <p class="eyebrow">Experiencia real</p>
      <h2>Propiedades gestionadas con confianza.</h2>
      <p>
        Usamos publicaciones reales, cierres y material visual de Clover para mostrar
        trayectoria sin transformar la web en un catalogo de propiedades disponibles.
      </p>
    </div>

    <div class="proof-grid">
      {featured.map((item) => (
        <article class="proof-card">
          <div class="proof-image">
            <img src={item.image} alt={`${item.title} - ${item.location}`} loading="lazy" />
          </div>
          <span>{item.kind}</span>
          <h3>{item.title}</h3>
          <p>{item.location}</p>
        </article>
      ))}
    </div>
  </div>
</section>
