---
import successes from "../data/successes.json";

const visibleSuccesses = successes.filter((item) => item.visible !== false);
---

<section id="experiencia" class="bg-clover-50 py-16 md:py-24 scroll-mt-20">
  <div class="container">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="section-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </span>
          <p class="eyebrow">Confianza</p>
        </div>
        <h2 class="section-title mt-4">Experiencia en ventas y asesorias.</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-ink/62">
        Una muestra de gestiones ya cerradas por Clover Propiedades. Sirve para mostrar experiencia sin guardar datos privados.
      </p>
    </div>

    <div class="scroll-row mt-10">
      {visibleSuccesses.map((item) => (
        <article class="flex flex-col items-center rounded-2xl border border-black/10 bg-white p-7 text-center shadow-[0_12px_40px_rgba(16,18,15,0.06)] transition hover:-translate-y-1 hover:shadow-soft">
          <div class="relative aspect-square w-full max-w-[292px] rounded-full bg-[conic-gradient(from_220deg,#21b4b2_0_43%,#73d75f_43%_72%,#21b4b2_72%_100%)] p-[7px] shadow-[0_18px_55px_rgba(16,18,15,0.16)]">
            <div class="relative h-full w-full overflow-hidden rounded-full bg-clover-50 ring-4 ring-white">
              <img src={item.image} alt={`${item.title} en ${item.location}`} class="h-full w-full object-cover grayscale" loading="lazy" />
              <div class="absolute inset-0 bg-ink/30"></div>
              <div class="absolute inset-0 flex items-center justify-center p-7">
                <div class="flex aspect-square w-[72%] items-center justify-center rounded-full bg-[#252525]/94 p-5 text-center text-white shadow-[0_18px_45px_rgba(0,0,0,0.28)] ring-2 ring-[#12200f]">
                  <div>
                    <svg viewBox="0 0 24 24" class="mx-auto h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z" />
                      <circle cx="12" cy="10" r="2" />
                    </svg>
                    <p class="mt-1 text-[0.62rem] font-black uppercase leading-tight tracking-wide">{item.location}</p>
                    <p class="mt-1 text-[0.62rem] font-black uppercase leading-tight tracking-wide">{item.client}</p>
                    <div class="my-2 flex items-center justify-center gap-2">
                      <svg viewBox="0 0 32 32" class="h-8 w-8 text-white" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M8 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                        <path d="M24 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                        <path d="M3 27v-3a6 6 0 0 1 10-4.4" />
                        <path d="M29 27v-3a6 6 0 0 0-10-4.4" />
                        <path d="m12 8 2-2 2 2 2-2" />
                      </svg>
                      <svg viewBox="0 0 36 36" class="h-9 w-9 text-white" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 19 18 7l14 12" />
                        <path d="M8 18v12h20V18" />
                        <path d="M15 30v-8h6v8" />
                        <circle cx="28" cy="9" r="4" />
                        <path d="M28 13v9" />
                        <path d="M28 18h4" />
                        <path d="M28 22h3" />
                      </svg>
                    </div>
                    <p class="text-lg font-black uppercase leading-none">Felicidades</p>
                    <p class="mt-2 text-[0.62rem] font-black uppercase leading-tight tracking-wide">{item.kind}</p>
                    <p class="mt-1 text-[0.62rem] font-black uppercase leading-tight tracking-wide">con exito</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-6">
            <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-clover-700">{item.kind}</p>
            <h3 class="mt-2 text-xl font-black leading-tight text-ink">{item.title}</h3>
            <p class="mt-1 text-sm font-bold text-ink/58">{item.location}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
