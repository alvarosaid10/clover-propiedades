---
import successes from "../data/successes.json";

const featured = successes.slice(0, 4);
---

<section id="resultados" class="results-card">
  <div class="section-top split">
    <div>
      <p class="eyebrow">Resultados</p>
      <h2>Operaciones y publicaciones que generan confianza.</h2>
    </div>
    <p>
      En vez de una vitrina eterna de propiedades disponibles, mostramos evidencia:
      operaciones cerradas, publicaciones reales y clientes atendidos.
    </p>
  </div>

  <div class="result-strip">
    {featured.map((item) => (
      <article class="result-item">
        <img src={item.image} alt={item.alt} loading="lazy" />
        <div>
          <span>{item.kind}</span>
          <h3>{item.title}</h3>
          <p>{item.location}</p>
        </div>
      </article>
    ))}
  </div>
</section>
