---
import site from "../data/site.json";
---

<footer class="border-t border-black/10 bg-white/80 py-10">
  <div class="container flex flex-col justify-between gap-5 text-sm text-ink/60 md:flex-row md:items-center">
    <div class="flex items-center gap-3">
      <img src="/images/corporate/logo-clover.jpg" alt="" class="h-8 w-8" />
      <span>Copyright {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</span>
    </div>
    <div class="flex flex-wrap gap-5 font-bold text-ink/70">
      <a href="#servicios">Servicios</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#resultados">Resultados</a>
      <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>
  </div>
</footer>
