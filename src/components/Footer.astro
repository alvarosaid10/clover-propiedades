---
import site from "../data/site.json";
---

<footer class="border-t border-black/10 py-10">
  <div class="container flex flex-col justify-between gap-5 text-sm text-ink/60 md:flex-row md:items-center">
    <div class="flex items-center gap-3">
      <img src="/images/brand/clover-mark.svg" alt="" class="h-8 w-8 transition-transform hover:rotate-12" />
      <span>© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</span>
    </div>
    <div class="flex gap-5 font-bold text-ink/70">
      <a href="#propiedades">Propiedades</a>
      <a href="#servicios">Servicios</a>
      <a href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>
  </div>
</footer>
