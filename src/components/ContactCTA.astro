---
import site from "../data/site.json";
---

<section id="contacto" class="contact">
  <div class="container contact-box">
    <div>
      <p class="eyebrow">Contacto directo</p>
      <h2>Quieres vender, arrendar o administrar una propiedad?</h2>
      <p>
        Escrible a Clover y recibe orientacion inicial sobre precio, estrategia,
        documentacion y pasos recomendados para tu caso.
      </p>
    </div>

    <div class="contact-actions">
      <a class="button button-light" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20evaluar%20una%20gestion%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
        Hablar por WhatsApp
      </a>
      <a class="button button-ghost" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
        Instagram
      </a>
      <p>{site.location}<br />{site.phone}<br />@{site.instagram}</p>
    </div>
  </div>
</section>
