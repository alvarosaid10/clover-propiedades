---
import site from "../data/site.json";
---

<section id="contacto" class="contact">
  <div class="container contact-box">
    <div>
      <p class="eyebrow">Contacto</p>
      <h2>Cotiza tu gestion inmobiliaria.</h2>
      <p>Agenda una asesoria y recibe orientacion clara sobre venta, arriendo o administracion.</p>
    </div>

    <div class="contact-actions">
      <a class="button button-light" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20cotizar%20una%20gestion%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
        WhatsApp
      </a>
      <a class="button button-ghost" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
        Instagram
      </a>
      <p>{site.location}<br />{site.phone}</p>
    </div>
  </div>
</section>
