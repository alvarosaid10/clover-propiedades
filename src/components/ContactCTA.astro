---
import site from "../data/site.json";
---

<section id="contacto" class="contact" data-reveal>
  <div class="container contact-box premium-surface" data-parallax-scope>
    <div class="contact-copy">
      <p class="eyebrow">Contacto</p>
      <h2>Conversemos tu próxima gestión</h2>
      <p>
        Cuéntanos si necesitas vender, arrendar o administrar una propiedad.
        Te responderemos por WhatsApp con una orientación inicial y el siguiente paso sugerido.
      </p>
    </div>

    <div class="contact-actions">
      <a class="button button-light" href={`https://wa.me/${site.whatsapp}?text=Hola%20Clover%20Propiedades%2C%20quiero%20cotizar%20una%20gesti%C3%B3n%20inmobiliaria.`} target="_blank" rel="noopener noreferrer">
        WhatsApp
      </a>
      <a class="button button-ghost" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">
        Instagram
      </a>
      <p>{site.location}<br />{site.phone}<br />{site.email}</p>
    </div>

    <div class="contact-seal" aria-hidden="true" data-parallax="-0.2">
      <span></span>
    </div>
  </div>
</section>
