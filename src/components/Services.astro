---
const services = [
  {
    title: "Compra",
    text: "Busqueda y revision comercial para encontrar una propiedad que calce con presupuesto, ubicacion y objetivos.",
    icon: "search"
  },
  {
    title: "Venta",
    text: "Publicacion, presentacion visual, filtro de interesados y acompanamiento hasta cerrar la operacion.",
    icon: "tag"
  },
  {
    title: "Arriendo",
    text: "Gestion practica para propietarios y arrendatarios, con contacto directo y seguimiento claro.",
    icon: "key"
  },
  {
    title: "Asesoria",
    text: "Orientacion inmobiliaria para tomar decisiones con mas seguridad antes de comprar, vender o invertir.",
    icon: "shield"
  }
];
---

<section id="servicios" class="py-16 md:py-24">
  <div class="container">
    <div class="soft-grid rounded-[1.75rem] border border-black/10 p-6 md:p-10">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="section-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 11.5 12 4l9 7.5" />
              <path d="M5.5 10.5V20h13v-9.5" />
              <path d="M9.5 20v-5h5v5" />
            </svg>
          </span>
          <p class="eyebrow">Servicios</p>
        </div>
        <h2 class="section-title mt-4">Gestion inmobiliaria clara y cercana.</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => (
          <article class="group overflow-hidden rounded-2xl border border-black/10 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:shadow-soft">
            <div class="mb-8 flex h-14 w-14 items-center justify-center rounded-3xl bg-clover-50 text-clover-700 shadow-sm">
              {service.icon === "search" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
              )}
              {service.icon === "tag" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 7v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7L13 2 4 7Z" />
                  <path d="M8 10h.01" />
                </svg>
              )}
              {service.icon === "key" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="8" cy="8" r="3" />
                  <path d="m11 11 9 9" />
                  <path d="m16 16 2-2" />
                  <path d="m19 19 2-2" />
                </svg>
              )}
              {service.icon === "shield" && (
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-extrabold">{service.title}</h3>
            <p class="mt-3 text-sm leading-6 text-ink/62">{service.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
