---
const pillars = [
  {
    name: "Venta",
    title: "Venta de propiedades",
    price: "2% + IVA",
    text: "Evaluación comercial, publicación, visitas, negociación, revisión documental y acompañamiento hasta la firma de escritura.",
    points: ["Valoración", "Marketing", "Visitas", "Documentos"],
    icon: `<path d="M4 20V9l8-5 8 5v11"></path><path d="M9 20v-6h6v6"></path>`
  },
  {
    name: "Arriendo",
    title: "Arriendo de propiedades",
    price: "50% + IVA",
    text: "Fijación de precio, difusión, selección de arrendatarios, contrato, entrega del inmueble y gestión de garantías.",
    points: ["Precio", "Filtro", "Contrato", "Entrega"],
    icon: `<circle cx="8" cy="8" r="4"></circle><path d="m11 11 9 9"></path><path d="m16 16 2-2"></path><path d="m19 19 2-2"></path>`
  },
  {
    name: "Administración",
    title: "Administración de propiedades",
    price: "Cotización personalizada",
    text: "Cobro de arriendos, pago de gastos y proveedores, coordinación de mantenciones, atención de arrendatarios e informes según el acuerdo definido.",
    points: ["Cobros", "Pagos", "Mantención", "Informes"],
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-5"></path>`
  }
];

const process = ["Evaluación", "Publicación", "Visitas", "Negociación", "Documentación", "Cierre"];

const support = [
  "Regularización de ampliaciones",
  "Asesoría documental",
  "Acompañamiento de principio a fin"
];
---

<section id="servicios" class="services clover-services" data-reveal>
  <div class="container clover-services-board">
    <div class="clover-services-top">
      <div class="clover-services-copy">
        <p class="eyebrow">Servicios</p>
        <h2>Tu operación en buenas manos</h2>
        <p>
          Clover Propiedades ordena la gestión comercial, coordina visitas y acompaña
          la revisión documental para que cada etapa avance con información clara.
        </p>
      </div>

      <aside class="clover-promise" aria-label="Gestión completa de principio a fin">
        <div>
          <span class="promise-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 7 9 18l-5-5"></path></svg>
          </span>
          <strong>Gestión completa de principio a fin</strong>
        </div>
        <ul>
          <li>Seguimiento directo de cada caso</li>
          <li>Comunicación transparente durante el proceso</li>
          <li>Acompañamiento comercial y documental</li>
        </ul>
      </aside>
    </div>

    <div class="clover-pillars" aria-label="Servicios principales">
      {pillars.map((pillar, index) => (
        <article class="clover-pillar" style={`--pillar:${index}`}>
          <div class="pillar-top">
            <span class="pillar-icon" set:html={`<svg viewBox="0 0 24 24">${pillar.icon}</svg>`} />
            <span class="pillar-name">{pillar.name}</span>
          </div>
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
          <div class="pillar-points">
            {pillar.points.map((point) => <span>{point}</span>)}
          </div>
          <strong>{pillar.price}</strong>
        </article>
      ))}
    </div>

    <div class="clover-flow" aria-label="Proceso de trabajo">
      {process.map((step, index) => (
        <span>
          <strong>{String(index + 1).padStart(2, "0")}</strong>
          {step}
        </span>
      ))}
    </div>

    <div class="clover-support" aria-label="Servicios adicionales">
      {support.map((item) => (
        <span>
          <i aria-hidden="true"></i>
          {item}
        </span>
      ))}
    </div>
  </div>
</section>
