---
const services = [
  {
    name: "Venta",
    price: "2% + IVA",
    text: "Valorizacion, marketing, visitas, negociacion, revision documental y acompanamiento hasta firma.",
    icon: `<path d="M4 20V9l8-5 8 5v11"></path><path d="M9 20v-6h6v6"></path>`
  },
  {
    name: "Arriendo",
    price: "50% + IVA",
    text: "Publicacion, filtro de arrendatarios, contrato, garantia y entrega ordenada del inmueble.",
    icon: `<circle cx="8" cy="8" r="4"></circle><path d="m11 11 9 9"></path><path d="m16 16 2-2"></path><path d="m19 19 2-2"></path>`
  },
  {
    name: "Administracion",
    price: "7% mensual",
    text: "Cobros, pagos, supervision, atencion de arrendatarios e informes periodicos para el propietario.",
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-5"></path>`
  }
];
---

<section id="servicios" class="services">
  <div class="container service-panel">
    <div class="service-intro">
      <p class="eyebrow">Servicios</p>
      <h2>Nos encargamos de todo.</h2>
      <p>Una gestion simple para el cliente: claridad, seguridad y seguimiento en cada etapa.</p>
    </div>

    <div class="service-grid">
      {services.map((service) => (
        <article class="service-tile">
          <span class="service-symbol" set:html={`<svg viewBox="0 0 24 24">${service.icon}</svg>`} />
          <h3>{service.name}</h3>
          <p>{service.text}</p>
          <strong>{service.price}</strong>
        </article>
      ))}
    </div>
  </div>
</section>
