---
const services = [
  {
    title: "Venta de propiedades",
    rate: "2% + IVA",
    text: "Valorizacion, marketing, gestion de visitas, revision documental y acompanamiento hasta firma.",
    items: ["Evaluacion y estrategia", "Marketing y publicacion", "Negociacion y cierre"],
    icon: "home"
  },
  {
    title: "Arriendo de propiedades",
    rate: "50% + IVA",
    text: "Fijacion de precio, filtro de arrendatarios, contrato, entrega y gestion de garantias.",
    items: ["Seleccion de arrendatarios", "Contrato y entrega", "Gestion de garantias"],
    icon: "key"
  },
  {
    title: "Administracion",
    rate: "7% mensual",
    text: "Cobro de arriendos, pagos, supervision del inmueble e informes periodicos.",
    items: ["Cobros y pagos", "Supervision del inmueble", "Informes periodicos"],
    icon: "shield"
  }
];
---

<section id="servicios" class="section-shell py-14 md:py-20">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Servicios</p>
        <h2 class="section-title mt-4">Gestion completa de principio a fin.</h2>
      </div>
      <p>
        Clover se encarga de ordenar el proceso comercial para que propietarios y clientes avancen con claridad, respaldo y una comunicacion cercana.
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-icon">
            {service.icon === "home" && <svg viewBox="0 0 24 24"><path d="M4 20V9l8-5 8 5v11"/><path d="M9 20v-6h6v6"/></svg>}
            {service.icon === "key" && <svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="4"/><path d="m11 11 9 9"/><path d="m16 16 2-2"/><path d="m19 19 2-2"/></svg>}
            {service.icon === "shield" && <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-5"/></svg>}
          </div>
          <p class="mt-8 text-xs font-black uppercase tracking-[0.18em] text-clover-700">{service.title}</p>
          <h3 class="mt-3 text-4xl font-black text-clover-900">{service.rate}</h3>
          <p class="mt-4 text-sm leading-6 text-ink/66">{service.text}</p>
          <ul class="mt-6 space-y-3">
            {service.items.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
