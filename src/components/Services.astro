---
const services = [
  {
    name: "Venta de propiedades",
    price: "2% + IVA",
    text: "Valor comercial, publicacion, agenda de visitas, negociacion y cierre con respaldo documental.",
    bullets: ["Valorizacion y marketing", "Gestion de visitas", "Firma y escritura"],
    icon: `<path d="M4 20V9l8-5 8 5v11"></path><path d="M9 20v-6h6v6"></path>`
  },
  {
    name: "Arriendo de propiedades",
    price: "50% + IVA",
    text: "Precio recomendado, seleccion de arrendatarios, contrato, garantia y entrega ordenada.",
    bullets: ["Filtro de interesados", "Contrato y garantia", "Entrega del inmueble"],
    icon: `<circle cx="8" cy="8" r="4"></circle><path d="m11 11 9 9"></path><path d="m16 16 2-2"></path><path d="m19 19 2-2"></path>`
  },
  {
    name: "Administracion",
    price: "7% mensual",
    text: "Cobro de arriendo, pagos, mantencion, atencion de arrendatarios e informes al propietario.",
    bullets: ["Cobros y pagos", "Supervision del inmueble", "Informes periodicos"],
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-5"></path>`
  }
];
---

<section id="servicios" class="services">
  <div class="container service-panel">
    <div class="service-intro">
      <p class="eyebrow">Servicios</p>
      <h2>Tu operacion en buenas manos</h2>
      <p>
        Clover acompana operaciones inmobiliarias completas para propietarios que
        necesitan avanzar con orden, seguridad y una comunicacion simple.
      </p>
      <div class="support-row" aria-label="Servicios adicionales">
        <span>Regularizacion DOM</span>
        <span>Asesoria documental</span>
        <span>Acompanamiento integral</span>
      </div>
    </div>

    <div class="service-grid">
      {services.map((service) => (
        <article class="service-tile">
          <span class="service-symbol" set:html={`<svg viewBox="0 0 24 24">${service.icon}</svg>`} />
          <h3>{service.name}</h3>
          <p>{service.text}</p>
          <ul>
            {service.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          <strong>{service.price}</strong>
        </article>
      ))}
    </div>
  </div>
</section>
