---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import site from "../data/site.json";

const {
  title = `${site.name} | Gestión Inmobiliaria`,
  description = site.description,
  image = "/images/corporate/info-clover.jpg",
  structuredData: pageStructuredData = []
} = Astro.props;

const canonical = new URL(Astro.url.pathname, `https://${site.domain}`);
const imageUrl = new URL(image, `https://${site.domain}`);
const organizationId = `https://${site.domain}/#organization`;
const websiteId = `https://${site.domain}/#website`;
const brandId = `https://${site.domain}/#brand`;
const baseStructuredData = [
{
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "@id": organizationId,
  name: site.name,
  legalName: "Clover Propiedades",
  alternateName: "Clover Propiedades Chile",
  slogan: "Compra, vende y arrienda con nosotros",
  url: `https://${site.domain}/`,
  logo: `https://${site.domain}/images/corporate/logo-clover-transparent-final.png`,
  image: imageUrl.href,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  priceRange: "$$",
  brand: { "@id": brandId },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: site.phone,
    contactType: "sales",
    areaServed: "CL",
    availableLanguage: "Spanish"
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Renca",
    addressRegion: "Región Metropolitana",
    addressCountry: "CL"
  },
  areaServed: "Chile",
  sameAs: [`https://www.instagram.com/${site.instagram}/`],
  knowsAbout: [
    "Venta de propiedades",
    "Arriendo de propiedades",
    "Administración de propiedades",
    "Asesoría inmobiliaria"
  ]
},
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `https://${site.domain}/#organization-profile`,
  name: "Clover Propiedades",
  url: `https://${site.domain}/`,
  logo: `https://${site.domain}/images/corporate/logo-clover-transparent-final.png`,
  description: site.description,
  contactPoint: {
    "@type": "ContactPoint",
    telephone: site.phone,
    contactType: "customer service",
    areaServed: "CL",
    availableLanguage: "Spanish"
  },
  sameAs: [`https://www.instagram.com/${site.instagram}/`]
},
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `https://${site.domain}/#localbusiness`,
  name: "Clover Propiedades",
  url: `https://${site.domain}/`,
  image: imageUrl.href,
  telephone: site.phone,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Renca",
    addressRegion: "Región Metropolitana",
    addressCountry: "CL"
  },
  areaServed: "Chile",
  priceRange: "$$"
},
{
  "@context": "https://schema.org",
  "@type": "Brand",
  "@id": brandId,
  name: "Clover Propiedades",
  logo: `https://${site.domain}/images/corporate/logo-clover-transparent-final.png`,
  url: `https://${site.domain}/`
},
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: site.name,
  url: `https://${site.domain}/`,
  publisher: { "@id": organizationId },
  inLanguage: "es-CL"
}
];

const structuredData = [...baseStructuredData, ...pageStructuredData];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#2f4d2c" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/corporate/logo-clover-transparent-final.png" type="image/png" />
    <link rel="preload" as="image" href="/images/corporate/asesora-clover.jpg" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G10YJ02TW4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "G-G10YJ02TW4");
    </script>
    <script is:inline>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const revealItems = () => {
        const items = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          items.forEach((item) => item.classList.add("is-visible"));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: "0px 0px -4% 0px" });
        items.forEach((item) => observer.observe(item));
      };

      const bindMotion = () => {
        if (reduceMotion) return;

        document.querySelectorAll("[data-parallax-scope]").forEach((scope) => {
          if (scope.dataset.motionBound) return;
          scope.dataset.motionBound = "true";

          scope.addEventListener("pointermove", (event) => {
            const rect = scope.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
            const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;

            scope.querySelectorAll("[data-parallax]").forEach((item) => {
              const strength = Number(item.dataset.parallax || 0.18);
              item.style.transform = `translate3d(${x * strength * 26}px, ${y * strength * 22}px, 0)`;
            });

            scope.querySelectorAll("[data-tilt-card]").forEach((card) => {
              card.style.setProperty("--tilt-x", `${y * -2.4}deg`);
              card.style.setProperty("--tilt-y", `${x * 2.4}deg`);
              card.style.setProperty("--glow-x", `${(x + 1) * 50}%`);
              card.style.setProperty("--glow-y", `${(y + 1) * 50}%`);
            });
          });

          scope.addEventListener("pointerleave", () => {
            scope.querySelectorAll("[data-parallax]").forEach((item) => {
              item.style.transform = "";
            });
            scope.querySelectorAll("[data-tilt-card]").forEach((card) => {
              card.style.removeProperty("--tilt-x");
              card.style.removeProperty("--tilt-y");
              card.style.removeProperty("--glow-x");
              card.style.removeProperty("--glow-y");
            });
          });
        });
      };

      revealItems();
      bindMotion();
      document.addEventListener("astro:page-load", revealItems);
      document.addEventListener("astro:page-load", bindMotion);
    </script>
  </head>
  <body>
    <div class="site-background" aria-hidden="true"></div>
    <slot />
  </body>
</html>
