---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import SuccessSection from "../components/SuccessSection.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import successes from "../data/successes.json";

const title = "Clover Propiedades | Experiencia y propiedades gestionadas";
const description = "Clover Propiedades muestra casos reales y registros de propiedades trabajadas como respaldo visual de su gestión inmobiliaria en distintas zonas.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `https://${site.domain}/experiencia/`,
    mainEntity: successes.map((item) => ({
      "@type": "CreativeWork",
      name: `${item.title} - ${item.location}`,
      about: item.kind,
      image: `https://${site.domain}${item.secondaryImage}`
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `https://${site.domain}/` },
      { "@type": "ListItem", position: 2, name: "Experiencia", item: `https://${site.domain}/experiencia/` }
    ]
  }
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <Header />
  <main class="content-page">
    <section class="container content-hero" data-reveal>
      <p class="eyebrow">Experiencia real</p>
      <h1>Experiencia de Clover Propiedades</h1>
      <p>
        Una selección breve de operaciones, registros y publicaciones reales que
        muestran cómo Clover Propiedades comunica, organiza y acompaña sus gestiones.
      </p>
    </section>
    <SuccessSection />
    <section class="container content-band" data-reveal>
      <h2>Confianza basada en gestión visible</h2>
      <p>
        La presencia digital de Clover se apoya en material real y contacto directo.
        Estos registros no son un catálogo de disponibilidad, sino una muestra del
        tipo de seguimiento y presentación que puede acompañar cada operación.
      </p>
      <a class="button button-primary" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener noreferrer">Ver Instagram</a>
    </section>
  </main>
  <ContactCTA />
  <Footer />
</BaseLayout>
