---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import SuccessSection from "../components/SuccessSection.astro";
import PortfolioStrip from "../components/PortfolioStrip.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";

const title = "Clover Propiedades | Gestión Inmobiliaria en Chile";
const description = "Clover Propiedades es una corredora de propiedades en Chile especializada en venta, arriendo, administración y asesoría inmobiliaria con gestión completa.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Services />
    <SuccessSection />
    <PortfolioStrip />
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
